@using DD3.CoverScope.Services
<section class="collection-progress" aria-labelledby="collection-progress-title">
    <div class="collection-progress-visual" aria-hidden="true">
        <div class="collection-progress-halo"></div>
        <svg class="collection-progress-mark" viewBox="0 0 64 64" focusable="false">
            <g class="collection-progress-ring">
                <path class="collection-progress-ring-primary" d="M36 6.3095A26 26 0 1 0 55.564 42.9881L48.3135 39.6071A18 18 0 1 1 36 14.4501Z" />
                <path class="collection-progress-ring-segment" d="M38.5 6.8256A26 26 0 0 1 54.9566 19.7937L47.8931 23.5495A18 18 0 0 0 38.5 15.2146Z" />
            </g>
            <g class="collection-progress-bars">
                <path class="collection-progress-bar bar-one" d="M21 35h6v10h-6z" />
                <path class="collection-progress-bar bar-two" d="M29 24h6v21h-6z" />
                <path class="collection-progress-bar bar-three" d="M37 30h6v15h-6z" />
            </g>
        </svg>
    </div>

    <div class="collection-progress-copy">
        <span class="eyebrow">COVERAGE COLLECTION</span>
        <h1 id="collection-progress-title">Collecting coverage</h1>
        <p class="collection-progress-target" title="@TargetPath">@Path.GetFileName(TargetPath)</p>
        <p class="collection-progress-phase" role="status" aria-live="polite" aria-atomic="true">
            <span class="collection-progress-pulse" aria-hidden="true"></span>
            <span class="visually-hidden">Coverage collection status: </span>
            @CoverageCollectionState.GetLabel(Phase)
        </p>
        <p class="collection-progress-elapsed" aria-label="Elapsed time: @ElapsedLabel">
            <span aria-hidden="true">@ElapsedLabel elapsed</span>
        </p>
    </div>
</section>
