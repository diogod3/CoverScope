@inject CoverageMetricsBuilder Metrics

<section class="metrics-view">
    <div class="metrics-summary-grid">
        <article class="metric-summary-card line-card">
            <span>Line coverage</span>
            <strong>@Report.Lines.Display</strong>
            <small>@Ratio(Report.Lines) lines covered</small>
        </article>
        <article class="metric-summary-card missed-card">
            <span>Missed lines</span>
            <strong>@Format(Report.Lines.Total - Report.Lines.Covered)</strong>
            <small>of @Format(Report.Lines.Total) instrumented lines</small>
        </article>
        <article class="metric-summary-card branch-card">
            <span>Branch coverage</span>
            <strong>@Report.Branches.Display</strong>
            <small>@Ratio(Report.Branches) branches covered</small>
        </article>
        <article class="metric-summary-card method-card">
            <span>Method coverage</span>
            <strong>@Report.Methods.Display</strong>
            <small>@Ratio(Report.Methods) methods reached</small>
        </article>
    </div>

    <div class="metrics-panel">
        <header class="metrics-panel-header">
            <div>
                <nav class="metric-breadcrumbs" aria-label="Metric level">
                    <button @onclick="ShowProjects">All projects</button>
                    @if (selectedProject is not null)
                    {
                        <span>›</span>
                        <button @onclick="ShowNamespaces">@selectedProject.Name</button>
                    }
                    @if (selectedNamespace is not null)
                    {
                        <span>›</span>
                        <strong>@selectedNamespace.Name</strong>
                    }
                </nav>
                <h3>@LevelTitle</h3>
                <p>@LevelDescription</p>
            </div>
            <span class="result-count">@VisibleRows.Count results</span>
        </header>

        <div class="metrics-controls">
            <label class="metrics-search">
                <span>Search</span>
                <input @bind="search" @bind:event="oninput" placeholder="Find @LevelName.ToLowerInvariant()…" />
            </label>
            <label>
                <span>Sort</span>
                <select @bind="sortMode">
                    <option value="@MetricSort.MostMissed">Most missed lines</option>
                    <option value="@MetricSort.LowestCoverage">Lowest coverage</option>
                    <option value="@MetricSort.Largest">Largest total</option>
                    <option value="@MetricSort.HighestCoverage">Highest coverage</option>
                    <option value="@MetricSort.Name">Name</option>
                </select>
            </label>
            <label>
                <span>Coverage</span>
                <select @bind="coverageThreshold">
                    <option value="101">Any coverage</option>
                    <option value="100">Below 100%</option>
                    <option value="90">Below 90%</option>
                    <option value="80">Below 80%</option>
                    <option value="60">Below 60%</option>
                </select>
            </label>
            <label class="minimum-lines">
                <span>Minimum lines</span>
                <input type="number" min="0" step="10" @bind="minimumLines" />
            </label>
            <label class="metrics-check">
                <input type="checkbox" @bind="onlyWithGaps" />
                <span>Only with gaps</span>
            </label>
        </div>

        @if (VisibleRows.Count == 0)
        {
            <div class="metrics-empty"><strong>No matching coverage metrics</strong><span>Try clearing the search or widening the filters.</span></div>
        }
        else
        {
            <div class="metrics-table-wrap">
                <table class="metrics-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Coverage</th>
                            <th class="number-column">Covered</th>
                            <th class="number-column">Missed</th>
                            <th class="number-column">Total</th>
                            <th>Branches</th>
                            <th>Methods</th>
                            <th class="number-column">Files</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in VisibleRows)
                        {
                            <tr tabindex="0" @onclick="() => OpenRow(row)" @onkeydown="(KeyboardEventArgs args) => HandleRowKey(args, row)">
                                <td class="metric-name-cell">
                                    <span class="metric-scope-icon @row.Scope.ToString().ToLowerInvariant()">@ScopeIcon(row.Scope)</span>
                                    <span>
                                        <strong>@row.Name</strong>
                                        <small>@RowSubtitle(row)</small>
                                    </span>
                                    <i class="row-arrow">→</i>
                                </td>
                                <td>
                                    <div class="table-coverage">
                                        <strong>@row.Lines.Display</strong>
                                        <div class="coverage-bar" style="@BarStyle(row.Lines)" role="progressbar" aria-label="@row.Name line coverage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(row.Lines.Percent)">
                                            <i></i>
                                        </div>
                                    </div>
                                </td>
                                <td class="number-column covered-number">@Format(row.Lines.Covered)</td>
                                <td class="number-column missed-number">@Format(row.Lines.Total - row.Lines.Covered)</td>
                                <td class="number-column">@Format(row.Lines.Total)</td>
                                <td>@CompactMetric(row.Branches)</td>
                                <td>@CompactMetric(row.Methods)</td>
                                <td class="number-column">@Format(row.FileCount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@code {
    private enum MetricSort { MostMissed, LowestCoverage, Largest, HighestCoverage, Name }

    [Parameter, EditorRequired] public CoverageReport Report { get; set; } = default!;
    [Parameter] public EventCallback<CoverageMetricRow> OnOpenClass { get; set; }

    private CoverageReport? currentReport;
    private PackageCoverage? selectedProject;
    private NamespaceCoverage? selectedNamespace;
    private MetricSort sortMode = MetricSort.MostMissed;
    private string search = string.Empty;
    private int coverageThreshold = 101;
    private int minimumLines;
    private bool onlyWithGaps;

    private string LevelName => selectedNamespace is not null ? "Classes" : selectedProject is not null ? "Namespaces" : "Projects";
    private string LevelTitle => $"Coverage by {LevelName.ToLowerInvariant()}";
    private string LevelDescription => selectedNamespace is not null
        ? "Logical classes are aggregated across all of their partial source files."
        : selectedProject is not null
            ? "Compare the namespaces in this project and drill into their classes."
            : "Compare projects and start with the areas containing the most missed lines.";

    private IReadOnlyList<CoverageMetricRow> VisibleRows => ApplyFiltersAndSort(BuildRows()).ToArray();

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(currentReport, Report)) return;
        currentReport = Report;
        selectedProject = null;
        selectedNamespace = null;
        search = string.Empty;
    }

    private IReadOnlyList<CoverageMetricRow> BuildRows() => selectedNamespace is not null && selectedProject is not null
        ? Metrics.BuildClasses(selectedProject, selectedNamespace)
        : selectedProject is not null
            ? Metrics.BuildNamespaces(selectedProject)
            : Metrics.BuildProjects(Report);

    private IEnumerable<CoverageMetricRow> ApplyFiltersAndSort(IEnumerable<CoverageMetricRow> rows)
    {
        var filtered = rows.Where(row =>
            (string.IsNullOrWhiteSpace(search)
                || row.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                || row.FullName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
            && row.Lines.Total >= minimumLines
            && (!onlyWithGaps || row.Lines.HasGaps)
            && (coverageThreshold > 100 || (row.Lines.Total > 0 && row.Lines.Percent < coverageThreshold)));

        return sortMode switch
        {
            MetricSort.LowestCoverage => filtered
                .OrderBy(row => row.Lines.Total == 0 ? double.MaxValue : row.Lines.Percent)
                .ThenBy(row => row.Name, StringComparer.OrdinalIgnoreCase),
            MetricSort.Largest => filtered
                .OrderByDescending(row => row.Lines.Total)
                .ThenBy(row => row.Name, StringComparer.OrdinalIgnoreCase),
            MetricSort.HighestCoverage => filtered
                .OrderByDescending(row => row.Lines.Percent)
                .ThenBy(row => row.Name, StringComparer.OrdinalIgnoreCase),
            MetricSort.Name => filtered.OrderBy(row => row.Name, StringComparer.OrdinalIgnoreCase),
            _ => filtered
                .OrderByDescending(row => row.Lines.Total - row.Lines.Covered)
                .ThenBy(row => row.Lines.Percent)
                .ThenBy(row => row.Name, StringComparer.OrdinalIgnoreCase)
        };
    }

    private Task OpenRow(CoverageMetricRow row)
    {
        if (row.Scope == CoverageMetricScope.Project)
        {
            selectedProject = row.Project;
            selectedNamespace = null;
            search = string.Empty;
            return Task.CompletedTask;
        }
        if (row.Scope == CoverageMetricScope.Namespace)
        {
            selectedProject = row.Project;
            selectedNamespace = row.Namespace;
            search = string.Empty;
            return Task.CompletedTask;
        }
        return OnOpenClass.InvokeAsync(row);
    }

    private Task HandleRowKey(KeyboardEventArgs args, CoverageMetricRow row) =>
        args.Key is "Enter" or " " ? OpenRow(row) : Task.CompletedTask;

    private void ShowProjects()
    {
        selectedProject = null;
        selectedNamespace = null;
        search = string.Empty;
    }

    private void ShowNamespaces()
    {
        selectedNamespace = null;
        search = string.Empty;
    }

    private static string ScopeIcon(CoverageMetricScope scope) => scope switch
    {
        CoverageMetricScope.Project => "P",
        CoverageMetricScope.Namespace => "N",
        _ => "C"
    };

    private static string RowSubtitle(CoverageMetricRow row) => row.Scope switch
    {
        CoverageMetricScope.Project => $"{row.ChildCount} namespaces · {row.FileCount} files",
        CoverageMetricScope.Namespace => $"{row.ChildCount} classes · {row.FileCount} files",
        _ when row.FileCount > 1 => $"partial class · {row.ChildCount} methods across {row.FileCount} files",
        _ => $"{row.ChildCount} methods · {row.ClassFragments.FirstOrDefault()?.RelativePath}"
    };

    private static string Ratio(CoverageMetric metric) => metric.Total == 0
        ? "No data"
        : $"{Format(metric.Covered)} / {Format(metric.Total)}";

    private static string CompactMetric(CoverageMetric metric) => metric.Total == 0
        ? "—"
        : $"{Format(metric.Covered)} / {Format(metric.Total)} · {metric.Percent:0.#}%";

    private static string BarStyle(CoverageMetric metric) =>
        $"--covered:{Math.Clamp(metric.Percent, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)}%;";

    private static string Format(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
}
