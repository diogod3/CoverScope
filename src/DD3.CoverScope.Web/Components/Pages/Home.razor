@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using DD3.CoverScope.Components.Review
@using DD3.CoverScope.Models.Reviews
@using DD3.CoverScope.Services.Reviews
@inject GitComparisonService Git
@inject ReviewStore Store
@inject ReviewOrchestrationService Runs
@inject ReviewExportService Exports
@inject CoverScopeLaunchContext Launch
@inject IJSRuntime JS

<PageTitle>CoverScope · Review changes</PageTitle>
@{
    var activeRun = repository is null ? null : Runs.ActiveRecord(repository.Root);
    var showProgress = activeRun is not null && !setup && view != "Runs" && (selected is null || selected.Record.Id == activeRun.Id);
}
<div class="review-app">
    <header class="review-header">
        <div class="review-brand"><img src="coverscope-mark.svg" alt="" /> CoverScope</div>
        <span class="review-target" title="@(repository?.Root)">@(repository is null ? "Committed change review" : System.IO.Path.GetFileName(repository.Root))</span>
        <button class="primary push" @onclick="OpenSetup" disabled="@(busy || activeRun is not null)">New run</button>
    </header>
    <nav class="review-nav" aria-label="Review navigation">
        @foreach (var name in new[] { "Overview", "Changes", "Verification", "Runs" })
        {
            <button aria-current="@(view == name || (view == "Type" && name == "Changes") ? "page" : null)" @onclick="() => Navigate(name)" disabled="@busy">@name</button>
        }
    </nav>
    <main class="@(setup ? "setup-main" : "workspace-main")">
        @if (!string.IsNullOrWhiteSpace(error)) { <p class="notice error" role="alert">@error</p> }
        @if (setup)
        {
            <section class="surface setup" aria-busy="@busy">
                <div class="setup-heading"><span class="eyebrow">New review</span><h1>Compare committed changes</h1><p class="muted">Choose your workspace, comparison branch, and the evidence to collect.</p></div>
                <label for="review-target-path">Solution or project</label>
                <div class="path-selection">
                    <input id="review-target-path" @bind="targetPath" @bind:event="oninput" @onkeydown="HandleTargetKey" disabled="@busy" placeholder="Path to SolutionExample.slnx" />
                    <button class="browse-button" @onclick="Browse" disabled="@busy">Browse…</button>
                    <button @onclick="Inspect" disabled="@(busy || string.IsNullOrWhiteSpace(targetPath))">@(busy ? "Loading…" : "Load repository")</button>
                </div>
                @if (busy) { <div class="loading-status" role="status" aria-live="polite"><span class="loading-spinner" aria-hidden="true"></span><span>Loading repository and saved configuration…</span></div> }
                @if (repository is not null)
                {
                    <fieldset class="setup-options" disabled="@busy">
                    <p class="setup-repository"><span class="eyebrow">Checked out</span><strong>@(repository.Branch ?? "Detached HEAD")</strong><code>@Short(repository.Commit)</code></p>
                    <label>Target branch<select @bind="targetBranch"><option value="">Select a local reference</option>
                        @foreach (var branch in repository.Branches) { <option value="@branch">@branch</option> }
                    </select></label>
                    <p class="muted">Uses the common ancestor with this local reference. Fetch through your Git client.</p>
                    <div class="setup-checks">
                        <label class="check"><input type="checkbox" @bind="testChecks" /><span>Tests and coverage<small>Build, test results, and execution coverage</small></span></label>
                        <label class="check"><input type="checkbox" @bind="formatCheck" /><span>Formatting analysis<small>Whitespace and style findings; no edits</small></span></label>
                    </div>
                    <label>Build configuration<input @bind="configuration" /></label>
                    <p class="muted">Git comparison and C# source indexing are included. Pending Git changes block a run.</p>
                    <div class="setup-actions"><button class="primary" @onclick="Start" disabled="@(busy || activeRun is not null || string.IsNullOrWhiteSpace(targetBranch))">Start run</button>
                    @if (selected is not null) { <button @onclick="() => setup = false" disabled="@busy">Back to review</button> }</div>
                    </fieldset>
                }
            </section>
        }
        @if (activeRun is { } active && !showProgress && !starting)
        {
            <section class="notice" role="status" aria-live="polite">
                <div class="row"><strong>@active.Status</strong><span>@Runs.Phase(active.Repository)</span>
                <button @onclick="() => Select(active)">View run</button>
                @if (active.Status is not ReviewStatus.CancellationIncomplete)
                { <button class="push" @onclick="Cancel" disabled="@(active.Status == ReviewStatus.Cancelling)">Cancel run</button> }</div>
                <p class="muted">Cancellation discards all analysis for this attempt, including completed checks.</p>
                @if (active.OperationalError is not null) { <p class="error">@active.OperationalError</p> }
            </section>
        }
        @if (starting)
        {
            <ReviewProgress PreparingTarget="@targetPath" Phase="Checking repository and preparing run…" />
        }
        else if (showProgress && activeRun is not null)
        {
            <ReviewProgress @key="activeRun.Id" Record="activeRun" Phase="@Runs.Phase(activeRun.Repository)" OnCancel="Cancel" />
        }
        else if (!setup && view == "Runs")
        {
            <h1>Run history</h1>
            <section class="surface">
                @if (history.Count == 0) { <p class="muted">No saved runs for this repository.</p> }
                @foreach (var run in history)
                {
                    <div class="list-row"><div><button class="text-button" @onclick="() => Select(run)">@run.StartedAt.ToLocalTime().ToString("g") · @run.Status</button><p class="muted">@Short(run.Commit) → @run.TargetRef</p></div></div>
                }
            </section>
        }
        else if (!setup && selected is not null)
        {
            <div class="title-row"><div><p class="eyebrow">Run @Short(selected.Record.Id) · @selected.Record.Status</p><h1>@System.IO.Path.GetFileNameWithoutExtension(selected.Record.TargetPath)</h1></div>
                <button @onclick="() => exporting = !exporting">Copy / export</button></div>
            <div class="context"><span>Commit <code>@Short(selected.Record.Commit)</code></span><span>Target @selected.Record.TargetRef <code>@Short(selected.Record.TargetCommit)</code></span><span>Common ancestor <code>@Short(selected.Record.Baseline)</code></span></div>
            @if (exporting)
            {
                <section class="surface export-panel"><div class="row"><button @onclick="() => jsonExport = false">Markdown summary</button><button @onclick="() => jsonExport = true">Full JSON evidence</button><button @onclick="CopyExport">Copy</button><button @onclick="DownloadExport">Download</button></div>
                <label>Export preview<textarea readonly>@ExportText</textarea></label></section>
            }
            @if (selected.Record.Status == ReviewStatus.Cancelled)
            { <section class="surface"><h2>Run cancelled</h2><p>All analysis was discarded. Only the run record remains.</p></section> }
            else if (selected.Record.Status is ReviewStatus.Cancelling or ReviewStatus.CancellationIncomplete or ReviewStatus.Preparing or ReviewStatus.Running or ReviewStatus.Finalising)
            {
                <section class="surface"><p>Analysis is unavailable while this attempt is active or unresolved.</p>
                    @if (repository is not null && Runs.ActiveRecord(repository.Root) is null)
                    { <label class="check"><input type="checkbox" @bind="recoveryChecked" /> I have verified that external processes from this attempt have stopped.</label><button @onclick="Recover" disabled="@(!recoveryChecked)">Discard interrupted analysis</button> }
                </section>
            }
            else if (selected.Evidence is { } evidence)
            {
                <p class="muted">@evidence.SourceConsistency</p>
                @if (view == "Overview")
                {
                    <div class="overview-workspace"><ReviewOverview Evidence="evidence" OnChanges="OpenChanges" OnVerification="OpenVerification" OnType="OpenType" /></div>
                }
                else if (view == "Verification")
                { <div class="verification-workspace"><ReviewVerification Evidence="evidence" OnFile="OpenFile" OnType="OpenType" /></div> }
                else if (view == "Type" && selectedType is not null)
                { <ReviewType Evidence="evidence" Type="selectedType" InitialMemberId="@selectedMemberId" OnType="OpenType" OnFile="OpenFile" OnVerification="OpenVerification" /> }
                else
                { <ReviewChanges Evidence="evidence" InitialFile="@selectedFile" OnType="OpenType" OnMember="OpenMember" /> }
            }
            @if (selected.Record.OperationalError is not null) { <p class="notice error">@selected.Record.OperationalError</p> }
        }
        else if (!setup && view != "Runs") { <p class="muted">Start a run or select one from history.</p> }
    </main>
    <footer><span>Local evidence for your review · no automatic acceptance decision</span><span role="status" aria-live="polite">@notification</span></footer>
</div>
<SolutionPicker @ref="picker" OnSelected="PickTarget" />

@code {
    private string targetPath = "", targetBranch = "", configuration = "Debug", view = "Overview", notification = "";
    private bool setup = true, busy, starting, testChecks = true, formatCheck = true, exporting, jsonExport, recoveryChecked;
    private string? error, selectedFile, selectedMemberId;
    private RepositoryContext? repository;
    private ReviewSnapshot? selected;
    private TypeEvidence? selectedType;
    private SolutionPicker? picker;
    private IReadOnlyList<ReviewRecord> history = [];
    private string ExportText => selected is null ? "" : jsonExport ? Exports.Json(selected) : Exports.Markdown(selected);

    protected override async Task OnInitializedAsync()
    {
        Runs.Changed += OnRunChanged;
        targetPath = Launch.InitialTargetPath ?? "";
        if (targetPath.Length > 0) { await Inspect(); }
    }
    private static string Short(string? value) => value is null ? "Unavailable" : value[..Math.Min(10, value.Length)];
    private void OpenSetup() { setup = true; error = null; }
    private void Navigate(string name) { view = name; setup = false; }
    private async Task Browse()
    {
        if (picker is null || busy) { return; }
        try { await picker.OpenAsync(targetPath); }
        catch (JSException ex) { error = "The picker could not open: " + ex.Message; }
    }
    private async Task PickTarget(string path) { targetPath = path; await Inspect(); }
    private async Task HandleTargetKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !busy && !string.IsNullOrWhiteSpace(targetPath)) { await Inspect(); }
    }
    private async Task Inspect()
    {
        if (busy) { return; }
        busy = true; error = null;
        try
        {
            StateHasChanged();
            await Task.Yield();
            repository = await Git.InspectAsync(targetPath);
            var settings = await Store.SettingsAsync(repository.Root);
            targetBranch = settings.TargetBranch; testChecks = settings.Tests; formatCheck = settings.Formatting; configuration = settings.Configuration;
            history = await Store.HistoryAsync(repository.Root);
        }
        catch (Exception ex) { error = ex.Message; repository = null; }
        finally { busy = false; }
    }
    private async Task Start()
    {
        if (busy || repository is null || Runs.ActiveRecord(repository.Root) is not null) { return; }
        var request = new ReviewRequest(targetPath, new(targetBranch, testChecks, formatCheck, configuration));
        busy = true; starting = true; error = null;
        setup = false; view = "Overview"; exporting = false;
        try
        {
            // Render preparation before repository checks or run persistence can wait.
            StateHasChanged();
            await Task.Yield();
            repository = await Git.InspectAsync(request.TargetPath);
            var record = await Runs.StartAsync(request);
            selected = new(record, null);
            starting = false;
            await Refresh();
        }
        catch (Exception ex) { error = ex.Message; setup = true; }
        finally { busy = false; starting = false; }
    }
    private async Task Cancel()
    {
        if (repository is null) { return; }
        try { await Runs.CancelAsync(repository.Root); await Refresh(); }
        catch (Exception ex) { error = ex.Message; }
    }
    private async Task Select(ReviewRecord record)
    {
        try { selected = await Store.ReadAsync(record); setup = false; view = "Overview"; selectedType = null; selectedFile = null; exporting = false; recoveryChecked = false; }
        catch (Exception ex) { error = ex.Message; }
    }
    private void OnRunChanged() => _ = InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
    private async Task Refresh()
    {
        if (repository is null) { return; }
        try
        {
            history = await Store.HistoryAsync(repository.Root);
            if (selected is not null)
            {
                var running = Runs.ActiveRecord(repository.Root);
                selected = running?.Id == selected.Record.Id ? new(running, null) : await Store.ReadAsync(selected.Record);
            }
        }
        catch (Exception ex) { error = ex.Message; }
    }
    private async Task Recover()
    {
        if (!recoveryChecked || selected is null) { return; }
        try { await Runs.RecoverAsync(selected.Record); await Refresh(); }
        catch (Exception ex) { error = ex.Message; }
    }
    private void OpenChanges() { selectedFile = null; view = "Changes"; }
    private void OpenVerification() => view = "Verification";
    private void OpenType(TypeEvidence type) { selectedType = type; selectedMemberId = null; view = "Type"; }
    private void OpenMember((TypeEvidence Type, string MemberId) selection) { selectedType = selection.Type; selectedMemberId = selection.MemberId; view = "Type"; }
    private void OpenFile(string path) { selectedFile = path; view = "Changes"; }
    private async Task CopyExport()
    {
        try { await JS.InvokeVoidAsync("CoverScope.copyText", ExportText); notification = "Copied export"; }
        catch (JSException) { notification = "Copy unavailable. Select the export preview and copy it manually."; }
    }
    private async Task DownloadExport() => await JS.InvokeVoidAsync("CoverScope.download", "coverscope-" + selected!.Record.Id + (jsonExport ? ".json" : ".md"), ExportText);
    public void Dispose() => Runs.Changed -= OnRunChanged;
}
