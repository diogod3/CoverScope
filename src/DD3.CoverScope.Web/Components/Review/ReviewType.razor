@using DD3.CoverScope.Models.Reviews
@using DD3.CoverScope.Services.Reviews
@if (navigation.Current is { } visit)
{
<div class="type-workspace review-studio @mode.ToLowerInvariant() @(mobileGraph ? "mobile-graph" : null)" style="@($"--graph-share:{graphWidth}%")">
    <header class="selection-strip studio-heading">
        <div class="studio-history"><button disabled="@(!navigation.CanGoBack)" @onclick="Back" aria-label="Previous type">← Back</button><button disabled="@(!navigation.CanGoForward)" @onclick="Forward" aria-label="Next type">Forward →</button></div>
        <div class="shrink"><h2 class="ellipsis" title="@visit.Type.FullName">@visit.Type.FullName</h2><p class="muted ellipsis" title="@visit.Type.Project">@visit.Type.Kind · @visit.Type.Change · @visit.Type.Project</p></div>
    </header>
    <div class="studio-toolbar">
        <div class="local-tabs" aria-label="Workspace layout"><button aria-pressed="@(mode == "Explore")" @onclick='() => SetMode("Explore")'>Explore</button><button aria-pressed="@(mode == "Inspect")" disabled="@(test is null)" @onclick='() => SetMode("Inspect")'>Inspect tests</button><button aria-pressed="@(mode == "Focus")" @onclick='() => SetMode("Focus")'>Focus</button></div>
        <button aria-pressed="@(evidenceTab == "Tests")" @onclick='() => ToggleEvidence("Tests")'>Tests</button><button aria-pressed="@(evidenceTab == "Formatting")" @onclick='() => ToggleEvidence("Formatting")'>Formatting</button>
        <label class="graph-size" hidden="@(mode != "Explore")">Graph width <input type="range" min="25" max="50" step="1" @bind="graphWidth" @bind:event="oninput" /></label>
        <button class="mobile-graph-toggle" hidden="@(mode != "Explore")" @onclick="() => mobileGraph = !mobileGraph">@(mobileGraph ? "Show code" : "Show graph")</button>
    </div>
    <div class="studio-panes">
        <aside class="studio-graph" hidden="@(mode != "Explore")">
            <ReviewRelationships Evidence="Evidence" Type="visit.Type" PreserveNavigation="true" OnType="NavigateType" />
        </aside>
        <section class="studio-production" aria-label="Production source">
            <div class="partial-navigation">
                <div class="partial-tabs" role="group" aria-label="Type source files">
                    @foreach (var file in ReviewWorkspaceNavigation.Files(visit.Type))
                    { <button aria-pressed="@(visit.File == file)" title="@file" @onclick="() => SelectFile(file)"><span class="ellipsis">@System.IO.Path.GetFileName(file)</span><small>@FileChange(file)</small></button> }
                </div>
                <div class="partial-selectors">
                    <label>All files (@ReviewWorkspaceNavigation.Files(visit.Type).Count)<select value="@visit.File" @onchange="e => SelectFile(e.Value?.ToString())">@foreach (var file in ReviewWorkspaceNavigation.Files(visit.Type)) { <option value="@file">@file · @FileChange(file)</option> }</select></label>
                    <label>Member<select value="@(visit.MemberId ?? "")" @onchange="SelectMember"><option value="">Full file</option>@foreach (var member in visit.Type.Members) { <option value="@member.Id">@member.Name · @System.IO.Path.GetFileName(member.Path) · @member.Change</option> }</select></label>
                </div>
            </div>
            <ReviewSource Evidence="Evidence" Path="@visit.File" InitialLine="@MemberLine(visit)" InitialRevision="@DefaultRevision(visit)" RememberPosition="true" StateKey="@visit.Key" NavigationVersion="@sourceNavigation" />
            @if (evidenceTab is not null)
            { <ReviewTypeEvidence Evidence="Evidence" Type="visit.Type" Tab="@evidenceTab" OnTest="OpenTest" OnClose="() => evidenceTab = null" OnVerification="OnVerification" /> }
        </section>
        <aside class="studio-test" hidden="@(mode != "Inspect")" aria-label="Test source">
            <header class="selection-strip"><div class="shrink"><h2 class="ellipsis" title="@test?.Type.FullName">@test?.Type.Name.@test?.Member.Name</h2><small>Test definition · static relationship</small></div><button @onclick="CloseTest">Return to code</button></header>
            @if (test is not null)
            { <ReviewSource Evidence="Evidence" Path="@test.Member.Path" InitialLine="@test.Member.Line" InitialRevision="@(test.Member.Change == "Deleted" ? "Baseline" : "Head")" RememberPosition="true" StateKey="@test.Type.Id" NavigationVersion="@testNavigation" /> }
        </aside>
    </div>
</div>
}
@code {
    [Parameter, EditorRequired] public ReviewEvidence Evidence { get; set; } = default!;
    [Parameter, EditorRequired] public TypeEvidence Type { get; set; } = default!;
    [Parameter] public string? InitialMemberId { get; set; }
    [Parameter] public long NavigationRequest { get; set; }
    [Parameter] public EventCallback OnVerification { get; set; }
    private readonly ReviewWorkspaceNavigation navigation = new();
    private long previousRequest = -1, sourceNavigation, testNavigation;
    private ReviewTestNavigation.Definition? test;
    private string mode = "Explore", returnMode = "Explore";
    private string? evidenceTab;
    private int graphWidth = 35;
    private bool mobileGraph;
    protected override void OnParametersSet()
    {
        if (previousRequest == NavigationRequest && navigation.Current is not null) { return; }
        previousRequest = NavigationRequest;
        navigation.Open(Type, Evidence, InitialMemberId);
        sourceNavigation++;
    }
    private void NavigateType(TypeEvidence type) { navigation.Open(type, Evidence); mobileGraph = false; evidenceTab = null; }
    private void Back() { navigation.Back(); mobileGraph = false; evidenceTab = null; }
    private void Forward() { navigation.Forward(); mobileGraph = false; evidenceTab = null; }
    private void SelectFile(string? file)
    {
        if (navigation.Current is not { } visit || file is null || !ReviewWorkspaceNavigation.Files(visit.Type).Contains(file)) { return; }
        visit.File = file; visit.MemberId = null;
    }
    private void SelectMember(ChangeEventArgs e)
    {
        if (navigation.Current is not { } visit) { return; }
        var member = visit.Type.Members.FirstOrDefault(x => x.Id == e.Value?.ToString());
        visit.MemberId = member?.Id;
        if (member is not null) { visit.File = member.Path; sourceNavigation++; }
    }
    private static int? MemberLine(ReviewWorkspaceNavigation.Visit visit) => visit.Type.Members.FirstOrDefault(x => x.Id == visit.MemberId)?.Line;
    private string DefaultRevision(ReviewWorkspaceNavigation.Visit visit) => visit.Type.Change == "Deleted" || visit.Type.Members.Any(x => x.Id == visit.MemberId && x.Change == "Deleted") ? "Baseline" : FileChange(visit.File) != "Unchanged" ? "Diff" : "Head";
    private string FileChange(string? path) => Evidence.Files.FirstOrDefault(x => x.Path == path || x.OldPath == path)?.Kind.ToString() ?? "Unchanged";
    private void ToggleEvidence(string tab)
    {
        if (mode == "Inspect") { SetMode("Focus"); }
        mobileGraph = false; evidenceTab = evidenceTab == tab ? null : tab;
    }
    private void SetMode(string value) { mode = value; mobileGraph = false; if (value == "Inspect") { evidenceTab = null; } }
    private void OpenTest(ReviewTestNavigation.Definition definition)
    { test = definition; testNavigation++; returnMode = mode == "Inspect" ? returnMode : mode; evidenceTab = null; SetMode("Inspect"); }
    private void CloseTest() => SetMode(returnMode);
}
