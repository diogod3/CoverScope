<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DD3.CoverScope</RootNamespace>
    <AssemblyName>DD3.CoverScope.Web</AssemblyName>
    <OutputType>Exe</OutputType>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>coverscope</ToolCommandName>
    <PackageId>DD3.CoverScope.Tool</PackageId>
    <Version>0.2.0-beta.2</Version>
    <Authors>Diogo Duarte</Authors>
    <Description>A local .NET workspace for reviewing committed changes, tests, coverage, and formatting.</Description>
    <PackageTags>dotnet-tool;code-review;code-coverage;git;blazor</PackageTags>
    <PackageProjectUrl>https://github.com/diogod3/CoverScope</PackageProjectUrl>
    <RepositoryUrl>https://github.com/diogod3/CoverScope</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>tools/net10.0/any/wwwroot/icon-512.png</PackageIcon>
    <PackageOutputPath>$(MSBuildProjectDirectory)/../../artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <Content Update="wwwroot/**/*" Pack="true" PackagePath="tools/$(TargetFramework)/any/wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Locator loads MSBuild from the installed SDK, not the application output. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
